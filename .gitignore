*.parquet
*.tar
*.tar.gz
*.tgz
*.zip
*.tfrecord*
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.h5
*.arrow
# rendered previews / galleries (regenerate with scripts/)
*.png
*.jpg
*.jpeg
*.webp
*.mp4
preview*.json
preview*.html
contact_sheets*.html
# ---- environments ----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# ---- secrets ---------------------------------------------------------------------
.env
*.token
.tinydit_token
# ---- OS / editor -----------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
